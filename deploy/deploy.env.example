# Copy to deploy.env and fill in. deploy.env is git-ignored and never committed.
#
#     cp deploy/deploy.env.example deploy/deploy.env
#
# None of these are secrets — they are the shape of one particular deployment. They live
# outside the repository because a public repository that names a host, an SSH endpoint
# and the account to reach it with has published a map, and a map is useful to somebody
# even when every lock on it still holds.

# Where to deploy. Anything ssh and scp accept.
DEPLOY_HOST=user@host.example.com

# The Cloudflare tunnel this host already runs. `cloudflared tunnel list` prints it.
# The tunnel's *credentials* file is the secret; this identifier is not, and it is still
# nobody's business which tunnel serves what.
TUNNEL_ID=00000000-0000-0000-0000-000000000000

# The dashboard, and the host that serves Short Codes. Two hostnames, for the reason in
# ADR-0006: the entire root namespace of the short host belongs to Short Codes, so it
# cannot share a hostname with an application that has routes of its own.
APP_HOSTNAME=app.example.com
SHORT_HOSTNAME=s.example.com

# Ports on the host. Change them if something already owns one — the defaults here dodge
# what happened to be running on the first host this deployed to.
APP_PORT=8090
CADDY_PORT=8088
REDIS_PORT=6380
